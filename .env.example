# ---- Core ----
NODE_ENV=development
PORT=8080
# Comma-separated browser origins allowed by CORS (the web app is same-origin in production)
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080

# ---- Database (Azure Database for PostgreSQL Flexible Server in prod) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory
DATABASE_SSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
# Bootstrap admin, created on first start when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Azure Blob Storage (product images) ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-images

# ---- Azure Application Insights (optional) ----
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Meta: WhatsApp Cloud API / Messenger / Instagram ----
META_APP_SECRET=dummy-meta-app-secret
META_VERIFY_TOKEN=dummy-verify-token
META_GRAPH_VERSION=v21.0
# META_GRAPH_BASE=https://graph.facebook.com   (only change for local E2E against a fake)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=
INSTAGRAM_PAGE_TOKEN=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=dummy-telegram-secret

# ---- Razorpay (payments; use TEST-mode keys until KYC/live) ----
RAZORPAY_KEY_ID=rzp_test_dummykey
RAZORPAY_KEY_SECRET=dummy-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=dummy-razorpay-webhook-secret
# RAZORPAY_API_BASE=https://api.razorpay.com   (only change for local E2E against a fake)
