// AI Project Engine v2 — the ONLY file you edit to adapt the engine to a project.
// After changing it run:  node engine/engine.mjs sync
{
  "version": 2,

  "project": {
    "name": "StockSync",
    // Filled during /engine-start (discovery). One paragraph: who it is for and what it must do.
    "goal": "Inventory management for small businesses: web dashboard + installable PWA + public shop, with ordering over WhatsApp, Messenger, Instagram and Telegram. Release 2 adds Razorpay payments (chat pay links, online checkout, cash on delivery) and WhatsApp tap-to-order buttons.",
    // web-api | fullstack | cli | mobile-backend | library | data-pipeline | other
    "type": "fullstack",
  },

  // Stack profile from engine/profiles (node-ts, python, dotnet, go, java-gradle) — or edit freely.
  "stack": {
    "profile": "node-ts",
    "description": "Node.js 22 LTS, TypeScript (strict), ESLint (typescript-eslint), Vitest",
    // Coding conventions rendered into AGENTS.md.
    "conventions": [
      "TypeScript strict mode with noUncheckedIndexedAccess; `any`, `@ts-ignore` and `eslint-disable` are forbidden (enforce `@typescript-eslint/no-explicit-any: error`).",
      "Validate every external input (HTTP, env, webhooks) with a schema library (e.g. zod) at the boundary.",
      "Read config only from a typed, validated env module; never `process.env.X` scattered in code.",
      "Pin exact dependency versions and check peer-dependency compatibility before adding a package.",
    ],
    "gitignore": ["node_modules/","dist/","build/","coverage/","*.log"],
    // GitHub Actions steps that install the toolchain (rendered into .github/workflows/engine-ci.yml).
    "ci": { "setup": ["- uses: actions/setup-node@v4","  with:","    node-version: 22","    cache: npm"] },
  },

  "commands": {
    "install": "npm ci",
    "dev": "npm run dev",
    // Quality gates, run in order by `engine gate` and `engine done`. required:false = warn only.
    // Add e2e (e.g. "npx playwright test"), secret scanning (e.g. "gitleaks detect --no-banner") etc.
    "gates": [
      { "name": "typecheck", "run": "npm run typecheck", "required": true },
      { "name": "lint", "run": "npm run lint", "required": true },
      // API tests need PostgreSQL at TEST_DATABASE_URL (default postgres://postgres@localhost:5432/inventory_test)
      { "name": "test", "run": "npm test", "required": true },
      { "name": "build", "run": "npm run build", "required": true },
      { "name": "audit", "run": "npm audit --omit=dev --audit-level=high", "required": false },
    ],
  },

  // How far the AI may go without you:
  //   "task"  = stop after every task · "phase" = stop at the end of each phase · "all" = run until done/blocked
  "autonomy": { "mode": "phase", "maxFixAttempts": 3 },

  // Human approval points enforced by the engine (remove one to skip it):
  //   after-plan    → `engine next` refuses to start until `engine approve plan`
  //   after-phase   → the next phase can't start until `engine approve phase "<name>"`
  //   before-deploy → /engine-deploy requires `engine approve deploy`
  "checkpoints": ["after-plan", "after-phase", "before-deploy"],

  // Token & context budget.
  "context": {
    "stateSummaryKeep": 15,     // newest log entries kept in 6_STATE_SUMMARY.md (older → docs/archive)
    "gateOutputLines": 60,      // failing gate output is truncated to the last N lines
    "clearAfter": "phase",      // suggest /clear after: "phase" | "task" | "never"
  },

  // Model routing. Claude Code: opus | sonnet | haiku | inherit (or a full model id).
  // Copilot: the model name exactly as shown in the VS Code model picker; empty = use the picker.
  "models": {
    "claude": { "planning": "opus", "coding": "sonnet", "review": "sonnet", "fast": "haiku" },
    "copilot": { "planning": "", "coding": "", "review": "", "fast": "" },
  },

  "git": {
    "commitPerTask": true,
    // Optional trailer appended to every engine commit, e.g. "Co-authored-by: AI <ai@example.com>"
    "commitTrailer": "",
  },

  // azure-container-apps | aws-ecs | gcp-cloud-run | vercel | fly | docker-vm | kubernetes | none
  "deploy": {
    "target": "azure-container-apps",
    "environments": ["staging", "production"],
    "notes": "Bicep in infra/main.bicep; CI/CD in .github/workflows/deploy.yml; guide in docs/DEPLOYMENT_GUIDE.md",
  },

  "security": {
    "secretFiles": [".env", ".env.*", "*.pem", "*.key", "*.pfx", "*secrets*.json"],
    "allowSecretFiles": [".env.example"],
  },

  // Set generateWorkflow to false if the project already has its own CI that runs the gates.
  "ci": { "generateWorkflow": false }, // StockSync already runs the gates in .github/workflows/deploy.yml

  // Claude Code hooks installed by `engine sync`.
  "hooks": { "guardSecrets": true, "gateOnStop": true },

  // MCP servers written once to .mcp.json (Claude Code) and .vscode/mcp.json (Copilot).
  // context7 = up-to-date library docs (fights version drift) · playwright = drive a real browser for UI checks.
  "mcp": {
    "servers": {
      "context7": { "command": "npx", "args": ["-y", "@upstash/context7-mcp"] },
      "playwright": { "command": "npx", "args": ["-y", "@playwright/mcp@latest"] },
    },
  },

  // Project-specific rules you discover along the way (rendered into AGENTS.md).
  "projectRules": [
    "Money is always integer minor units (cents/paise) end-to-end; format only at the edges.",
    "Stock changes go only through StockService (atomic conditional UPDATE + ledger); never write stock_levels directly.",
    "API tests run against real PostgreSQL; each test file gets a fresh schema via tests/helpers/db.ts — never reset the DB inside a test file.",
    "Every webhook verifies its signature on the raw body with a timing-safe compare and is idempotent on retries.",
    "Payment amounts are always computed server-side from the order; never trust an amount from the client or a callback URL.",
    "Shared domain types live in src/api/src/domain/types.ts and are imported by the web app (type-only)."
  ],
}
