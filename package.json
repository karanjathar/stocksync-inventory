{
  "name": "stocksync",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "src/api",
    "src/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @stocksync/api & npm run dev -w @stocksync/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @stocksync/web && npm run build -w @stocksync/api",
    "start": "npm run start -w @stocksync/api",
    "e2e": "node scripts/e2e/payments.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
